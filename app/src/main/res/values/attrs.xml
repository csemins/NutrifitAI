<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CalorieRingView">
        <attr name="ringStroke" format="dimension" />
        <attr name="ringStartColor" format="color" />
        <attr name="ringEndColor" format="color" />
        <attr name="ringTrackColor" format="color" />
    </declare-styleable>
    <declare-styleable name="MacroBarView">
        <attr name="barColor" format="color" />
        <attr name="barHeight" format="dimension" />
    </declare-styleable>
    <declare-styleable name="SegmentedView">
        <attr name="segments" format="reference" />
    </declare-styleable>
    <declare-styleable name="MuscleMapView">
        <attr name="muscleMode" format="enum">
            <enum name="both" value="0" />
            <enum name="front" value="1" />
            <enum name="back" value="2" />
        </attr>
        <attr name="selectable" format="boolean" />
    </declare-styleable>
</resources>
