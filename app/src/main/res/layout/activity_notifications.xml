<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <include android:id="@+id/bar" layout="@layout/view_top_bar" />

    <!-- Shown while notifications are off for the app -->
    <LinearLayout
        android:id="@+id/offBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_neon"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_bell" app:tint="@color/nl_protein" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/NL.Text.BodyStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notif_off_title" />
            <TextView style="@style/NL.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/notif_off_body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/turnOn"
            style="@style/NL.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/notif_turn_on" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_notification" />

        <include
            android:id="@+id/empty"
            layout="@layout/item_social_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
