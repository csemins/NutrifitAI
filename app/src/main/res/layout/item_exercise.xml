<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card_sm_pressable"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.transformsai.nutrifitai.ui.widget.ExerciseAnimView
        android:id="@+id/image"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_photo_round"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/NL.Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Bodyweight squat" />

        <TextView
            android:id="@+id/sub"
            style="@style/NL.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Quads · glutes" />
    </LinearLayout>

    <ImageView
        android:id="@+id/camera"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_badge_lime"
        android:contentDescription="@string/tracked"
        android:padding="7dp"
        android:src="@drawable/ic_camera"
        app:tint="@color/nl_lime" />
</LinearLayout>
