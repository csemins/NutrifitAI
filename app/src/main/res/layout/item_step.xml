<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card_sm_pressable"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.transformsai.nutrifitai.ui.widget.ExerciseAnimView
        android:id="@+id/image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_photo_round"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/NL.Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Squat" />

        <TextView
            android:id="@+id/sub"
            style="@style/NL.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="12 reps · rest 20 s" />
    </LinearLayout>

    <TextView
        android:id="@+id/camera"
        style="@style/NL.Text.MacroChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_lime"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="9dp"
        android:paddingVertical="4dp"
        android:text="@string/tracked"
        android:textColor="@color/nl_lime"
        app:drawableStartCompat="@drawable/ic_camera_small"
        app:drawableTint="@color/nl_lime" />
</LinearLayout>
