<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/share_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:accessibilityHeading="true" android:ellipsize="end" android:fontFamily="@font/jakarta_bold" android:maxLines="1" android:textColor="@color/share_text" android:textSize="18sp" tools:text="Morning crew" />
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jakarta_medium" android:textColor="@color/share_lime" android:textSize="13sp" tools:text="3 in call · 02:14" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tiles: me and everyone else, arranged in rows -->
    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="18dp">

        <ImageButton android:id="@+id/mic" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_call_button" android:contentDescription="@string/call_mute" android:padding="17dp" android:scaleType="fitCenter" android:src="@drawable/ic_mic" app:tint="@color/share_text" />
        <ImageButton android:id="@+id/camera" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="16dp" android:background="@drawable/bg_call_button" android:contentDescription="@string/call_camera_off" android:padding="17dp" android:scaleType="fitCenter" android:src="@drawable/ic_video" app:tint="@color/share_text" />
        <ImageButton android:id="@+id/flip" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="16dp" android:background="@drawable/bg_call_button" android:contentDescription="@string/cd_flip_camera" android:padding="17dp" android:scaleType="fitCenter" android:src="@drawable/ic_flip" app:tint="@color/share_text" />
        <ImageButton android:id="@+id/hangup" android:layout_width="68dp" android:layout_height="60dp" android:layout_marginStart="16dp" android:background="@drawable/bg_call_end" android:contentDescription="@string/call_leave" android:padding="16dp" android:scaleType="fitCenter" android:src="@drawable/ic_call_end" app:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
