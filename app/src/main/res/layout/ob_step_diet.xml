<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/hero"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_photo_round"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/hero_ob_diet" />
    <TextView style="@style/NL.Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ob_diet_title" />
    <TextView android:id="@+id/motto" style="@style/NL.Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ob_motto_diet" />

    <TextView style="@style/NL.Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ob_diet" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/diet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingVertical="4dp" />

    <TextView style="@style/NL.Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ob_allergies" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/allergies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingVertical="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/ob_allergy_other">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/otherAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="120" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/NL.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_banner_warning"
        android:drawablePadding="10dp"
        android:padding="14dp"
        android:text="@string/ob_allergy_note"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="@color/nl_warning" />
</LinearLayout>
