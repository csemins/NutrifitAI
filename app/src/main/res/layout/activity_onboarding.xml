<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth">

    <ImageButton
        android:id="@+id/back"
        style="@style/NL.IconButton"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/stepLabel"
        style="@style/NL.Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@id/back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/back" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:max="5"
        app:indicatorColor="@color/nl_lime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back"
        app:trackColor="@color/nl_surface_3"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <include android:id="@+id/stepAbout" layout="@layout/ob_step_about" />

            <include android:id="@+id/stepBody" layout="@layout/ob_step_body" />

            <include android:id="@+id/stepGoal" layout="@layout/ob_step_goal" />

            <include android:id="@+id/stepDiet" layout="@layout/ob_step_diet" />

            <include android:id="@+id/stepTargets" layout="@layout/ob_step_targets" />

            <include android:id="@+id/stepPermissions" layout="@layout/ob_step_permissions" />
        </ViewFlipper>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Final celebration after signup -->
    <LinearLayout
        android:id="@+id/ready"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_auth"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:layout_width="132dp" android:layout_height="132dp">
            <View android:id="@+id/readyGlow" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_avatar_ring" android:alpha="0.35" />
            <ImageView
                android:id="@+id/readyCheck"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_ring"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_check"
                app:tint="@color/nl_on_lime" />
        </FrameLayout>

        <TextView android:id="@+id/readyTitle" style="@style/NL.Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:text="@string/ob_ready_title" />
        <TextView android:id="@+id/readyBody" style="@style/NL.Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/ob_ready_body" />
        <TextView android:id="@+id/readyKcal" style="@style/NL.Text.NumberHuge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:textColor="@color/nl_lime" />
        <TextView style="@style/NL.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ob_ready_kcal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readyGo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="36dp"
            android:text="@string/ob_ready_go" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
