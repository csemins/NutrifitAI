<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dashed"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <ImageButton
        android:id="@+id/add"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_stepper_minus"
        android:contentDescription="@string/add"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:tint="@color/nl_text_2" />

    <LinearLayout
        android:id="@+id/coach"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/NL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nothing_logged" />

        <TextView
            style="@style/NL.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ask_coach_idea"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
