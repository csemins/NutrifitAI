<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/bar"
        layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_neon"
                android:paddingVertical="22dp">

                <FrameLayout
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_gravity="center_horizontal">

                    <com.transformsai.nutrifitai.ui.widget.CalorieRingView
                        android:id="@+id/ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:ringStroke="16dp" />

                    <ImageView
                        android:id="@+id/idleArt"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ill_fasting" />

                    <LinearLayout
                        android:id="@+id/timerBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/NL.Text.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fasting_elapsed"
                            android:textColor="@color/nl_lime" />

                        <TextView
                            android:id="@+id/elapsed"
                            style="@style/NL.Text.NumberHuge"
                            android:layout_width="150dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeMaxTextSize="40sp"
                            app:autoSizeMinTextSize="20sp"
                            app:autoSizeTextType="uniform"
                            android:textSize="40sp"
                            tools:text="12:45" />

                        <TextView
                            android:id="@+id/target"
                            style="@style/NL.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="of 16 h" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/state"
                style="@style/NL.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                tools:text="Fasting since 8:30 PM" />

            <TextView
                android:id="@+id/stateSub"
                style="@style/NL.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                tools:text="Ends at 12:30 PM · 3 h 15 min left" />

            <TextView
                android:id="@+id/presetsTitle"
                style="@style/NL.Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fasting_window" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/NL.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fasting_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/earlier"
                style="@style/NL.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fasting_started_earlier" />

            <TextView
                android:id="@+id/historyTitle"
                style="@style/NL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/fasting_history" />

            <LinearLayout
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
