<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_bg"
    android:orientation="vertical">

    <!-- Top bar: back, who, call buttons -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton android:id="@+id/back" style="@style/NL.IconButton" android:contentDescription="@string/cd_back" android:src="@drawable/ic_back" />

        <com.transformsai.nutrifitai.ui.widget.FoodThumbView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/who"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView android:id="@+id/title" style="@style/NL.Text.BodyStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:accessibilityHeading="true" android:ellipsize="end" android:maxLines="1" tools:text="Morning crew" />
            <TextView android:id="@+id/subtitle" style="@style/NL.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" tools:text="4 members" />
        </LinearLayout>

        <ImageButton android:id="@+id/audioCall" style="@style/NL.IconButton" android:contentDescription="@string/call_audio" android:src="@drawable/ic_call" />
        <ImageButton android:id="@+id/videoCall" style="@style/NL.IconButton" android:layout_marginStart="4dp" android:contentDescription="@string/call_video" android:src="@drawable/ic_video" />
        <ImageButton android:id="@+id/more" style="@style/NL.IconButton" android:layout_marginStart="4dp" android:contentDescription="@string/more" android:src="@drawable/ic_more" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nl_stroke" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView android:layout_width="130dp" android:layout_height="130dp" android:importantForAccessibility="no" android:src="@drawable/ill_chat" />
            <TextView android:id="@+id/emptyTitle" style="@style/NL.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" tools:text="Say hi to Sami" />
            <TextView style="@style/NL.Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/chat_empty_body" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageButton android:id="@+id/challenge" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_round_glass" android:contentDescription="@string/challenge_new" android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_trophy" app:tint="@color/nl_carbs" />
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input_chat" android:fontFamily="@font/jakarta_medium" android:hint="@string/chat_hint" android:importantForAutofill="no" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:maxLines="4" android:minHeight="52dp" android:paddingHorizontal="18dp" android:paddingVertical="12dp" android:textColor="@color/nl_text" android:textColorHint="@color/nl_text_3" android:textSize="15sp" />
        <ImageButton android:id="@+id/send" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:background="@drawable/bg_nav_camera" android:contentDescription="@string/cd_send" android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_send" app:tint="@color/nl_on_lime" />
    </LinearLayout>
</LinearLayout>
