<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.transformsai.nutrifitai.ui.widget.FoodThumbView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/lowConf"
        style="@style/NL.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_warning"
        android:drawablePadding="10dp"
        android:padding="14dp"
        android:text="@string/ai_low_conf"
        android:textColor="@color/nl_text"
        app:drawableStartCompat="@drawable/ic_warning"
        app:drawableTint="@color/nl_warning" />

    <TextView
        android:id="@+id/warnings"
        style="@style/NL.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_info"
        android:padding="14dp" />

    <TextView
        android:id="@+id/questions"
        style="@style/NL.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_info"
        android:padding="14dp"
        android:textColor="@color/nl_text" />
</LinearLayout>
