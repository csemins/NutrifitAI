    <item android:width="34dp" android:height="34dp"><shape android:shape="oval"><solid android:color="#40B8F15A" /></shape></item>
    <item android:width="20dp" android:height="20dp" android:gravity="center"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
    <item android:width="14dp" android:height="14dp" android:gravity="center"><shape android:shape="oval"><solid android:color="#FFB8F15A" /></shape></item>
</layer-list>
