<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/nl_surface" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="420dp" android:centerX="0.1" android:centerY="0.05"
                android:startColor="#663E7F22" android:centerColor="#1A27461A" android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/nl_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
