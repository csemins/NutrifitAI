<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/nl_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/nl_tint_green" />
                    <stroke android:width="1.5dp" android:color="@color/nl_lime" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/nl_surface" />
                    <stroke android:width="1dp" android:color="@color/nl_stroke" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
