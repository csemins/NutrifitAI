<?xml version="1.0" encoding="utf-8"?>
<!-- Dark panel behind the podium (same look as the share card in both themes) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/share_bg" /><corners android:radius="24dp" /></shape></item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.5" android:centerY="0.1"
                android:startColor="#40FFE07A" android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
