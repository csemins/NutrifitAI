<?xml version="1.0" encoding="utf-8"?>
<!-- Page indicator: a lime pill for the current page, a small muted dot for the others (width set in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/nl_lime" /><corners android:radius="4dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/nl_stroke_strong" /><corners android:radius="4dp" /></shape>
    </item>
</selector>
