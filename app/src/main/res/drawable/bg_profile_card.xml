<?xml version="1.0" encoding="utf-8"?>
<!-- Profile card: card surface with a soft lime glow from the top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/nl_surface" /><corners android:radius="28dp" /><stroke android:width="1dp" android:color="@color/nl_stroke" /></shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="260dp" android:centerX="0.5" android:centerY="0.0"
                android:startColor="@color/nl_lime_glow" android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
