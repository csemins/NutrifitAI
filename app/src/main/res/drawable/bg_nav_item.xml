<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/nl_ripple">
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="26dp" /></shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><solid android:color="@color/nl_tint_green_soft" /><corners android:radius="26dp" /></shape>
            </item>
            <item><shape><solid android:color="@android:color/transparent" /></shape></item>
        </selector>
    </item>
</ripple>
