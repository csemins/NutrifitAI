<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking: Firebase + NutriFit AI AI proxy -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime permissions, each requested in context -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- calls: speakerphone and communication audio mode -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restore reminder alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- User-started export runs as a dataSync foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Walk tracker: step counter sensor and the user-started walk session -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- GPS walk routes (while a walk the user started is running) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Health Connect (Android 14+): read steps, write workouts, weight and water -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility (Android 11+): find an on-device speech recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.NutriFit"
        tools:targetApi="34">

        <activity
            android:name=".ui.launch.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.NutriFit.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.WelcomeActivity" android:exported="false" />
        <activity android:name=".ui.auth.AuthActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.onboarding.OnboardingActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.main.MainActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".ui.food.FoodSearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity android:name=".ui.food.FoodDetailActivity" android:exported="false" />
        <activity android:name=".ui.food.CustomFoodActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.camera.CameraActivity" android:exported="false" android:theme="@style/Theme.NutriFit.Camera" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.analysis.AnalysisActivity" android:exported="false" />
        <activity android:name=".ui.analysis.VoiceLogActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.hydration.HydrationActivity" android:exported="false" />
        <activity android:name=".ui.weight.WeightActivity" android:exported="false" />
        <activity android:name=".ui.train.WorkoutDetailActivity" android:exported="false" />
        <activity android:name=".ui.steps.StepsActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".ui.steps.WalkActivity" android:exported="false" android:launchMode="singleTop"
            android:theme="@style/Theme.NutriFit.Camera" />
        <activity android:name=".ui.steps.WalkSummaryActivity" android:exported="false"
            android:theme="@style/Theme.NutriFit.Camera" />
        <activity android:name=".ui.fasting.FastingActivity" android:exported="false" />
        <activity android:name=".ui.achievements.AchievementsActivity" android:exported="false" />
        <!-- Health Connect shows this screen when the user asks why NutriFit AI wants health data -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.settings.PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".health.WalkService"
            android:exported="false"
            android:foregroundServiceType="health|location" />
        <activity android:name=".ui.train.AiWorkoutActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Live camera session: handles rotation itself so the workout and camera are not torn down. -->
        <activity
            android:name=".ui.train.WorkoutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.NutriFit.Camera" />
        <activity android:name=".ui.train.WorkoutSummaryActivity" android:exported="false" />
        <activity android:name=".ui.train.ExerciseLibraryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.train.ExerciseDetailActivity" android:exported="false" />
        <activity android:name=".ui.assistant.AssistantActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.recipes.RecipesActivity" android:exported="false" />
        <activity android:name=".ui.recipes.RecipeEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.settings.PrivacyActivity" android:exported="false" />
        <!-- Social: share, challenges, clips -->
        <activity android:name=".ui.social.ComposePostActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.social.NewChallengeActivity" android:exported="false" />
        <activity android:name=".ui.social.ChallengeLobbyActivity" android:exported="false" />
        <activity android:name=".ui.social.ChallengeResultActivity" android:exported="false" />
        <activity android:name=".ui.social.ClipPlayerActivity" android:exported="false" android:theme="@style/Theme.NutriFit.Camera" />
        <activity android:name=".ui.social.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.social.ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.social.CommentsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.social.NewGroupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.call.CallActivity" android:exported="false" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.NutriFit.Camera" />
        <activity android:name=".ui.profile.EditProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Exported so "Open with NutriFit AI" works for XML backups from a file manager or email. -->
        <activity android:name=".ui.settings.ExportImportActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity>

        <service
            android:name=".io.ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".reminders.TimeChangeReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
