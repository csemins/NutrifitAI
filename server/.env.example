# Copy to .env (git-ignored). Never commit the real key.
NUTRIFIT_LLM_API_KEY=replace-with-your-gateway-key
FIREBASE_PROJECT_ID=nutrifit-ai-6c41c
HOST=127.0.0.1
PORT=8787
UPSTREAM_BASE_URL=http://localhost:3000
UPSTREAM_MODEL=auto
# BUCKET_DIR=storage
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099   (development only: accept emulator tokens)
# Demo: let every signed-in account use AI without the aiAccess approval (sign-in and rate limits still apply)
AI_OPEN_TO_ALL=true
# Call relay (TURN) so calls connect on mobile data / strict NATs. Pick one:
#  a) Cloudflare Realtime TURN (dash.cloudflare.com -> Realtime -> TURN Server -> create key):
# CF_TURN_KEY_ID=
# CF_TURN_KEY_API_TOKEN=
#  b) your own TURN server (coturn with use-auth-secret), comma-separated URLs:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
#  c) or fixed credentials, e.g. ExpressTURN free plan (expressturn.com, 1000 GB/month, no payment):
# TURN_URLS=turn:HOST_FROM_DASHBOARD:3478?transport=udp,turn:HOST_FROM_DASHBOARD:3478?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
